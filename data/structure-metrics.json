  "articles_moved": "articles whose folder path changed (renaming a top-level folder moves everything below it)",
  "articles_moved_by_folder_title": "articles whose containing folder's title (case-insensitive) changed",
  "misfiled_fixed": "articles whose after top-level section is not the successor of their before top-level category (successor = the before top-level category supplying most of that after section's articles)",
  "boilerplate_sentence_share": "per top-level section: share of sentences with >= 6 words appearing verbatim in >= 3 articles of the same tree"
